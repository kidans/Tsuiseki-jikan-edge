{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsuiseki-jikan-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  // Tsuiseki fork: never inherit the upstream author's custom domain.
  // Codex/`npm run setup:tsuiseki` may add a custom domain later if desired.
  "routes": [],
  // Keep upstream static assets available during bootstrap. Tsuiseki only depends
  // on /health and exact-id API routes; the landing page is not part of the contract.
  "assets": { "directory": "./site" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "MAL_USER_AGENT": "Tsuiseki-jikan-edge/0.1 (+https://github.com/kidans/Tsuiseki-jikan-edge)",
    "PROFILE_TTL_SECONDS": "21600",
    "LIST_TTL_SECONDS": "7200",
    "ANIME_TTL_SECONDS": "21600",
    "CATALOG_TTL_SECONDS": "21600",
    "SOURCE_TIMEOUT_MS": "8000",
    "MAX_UPSTREAM_BYTES": "5242880",
    "WORKER_VERSION": "tsuiseki-jikan-edge-bootstrap-2026-09-02"
  },
  // Fail-safe placeholder. `npm run setup:tsuiseki` creates/reuses the real D1
  // database and replaces this id before any Production deployment.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsuiseki-jikan-edge",
      "database_id": "524d177d-63ab-4af1-9162-9b10788bfca8"
    }
  ],
  // Namespace ids are scoped to the Cloudflare account, so these counters do
  // not share state with upstream even when the numeric ids are the same.
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "18973", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_BURST_LIMIT", "namespace_id": "18974", "simple": { "limit": 30, "period": 10 } }
  ]
}
